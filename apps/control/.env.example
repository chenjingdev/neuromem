NEUROMEM_CONTROL_DATABASE_URL=postgresql+psycopg://neuromem:change-me@postgres/neuromem_control
NEUROMEM_CONTROL_NODE_ID=local-development-node
NEUROMEM_CONTROL_SECRET_KEY=replace-with-at-least-32-random-characters
NEUROMEM_CONTROL_AUTO_CREATE_SCHEMA=false
NEUROMEM_CONTROL_SECURE_COOKIES=true
NEUROMEM_CONTROL_PORT=8000
NEUROMEM_CONTROL_MEMORY_CORE_URL=http://memory-core:8000
NEUROMEM_CONTROL_NODE_MANAGER_URL=http://host.docker.internal:14174
NEUROMEM_CONTROL_NODE_MANAGER_TIMEOUT_SECONDS=600
NEUROMEM_CONTROL_MEMORY_CORE_TIMEOUT_SECONDS=120
NEUROMEM_CONTROL_MEMORY_CORE_MAX_RESPONSE_BYTES=16777216
NEUROMEM_CONTROL_INTERNAL_SIGNING_KEY=replace-with-a-separate-32-byte-signing-secret
