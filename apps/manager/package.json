{
  "name": "neuromem",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "neuromem": "dist/src/cli.js",
    "neuromemd": "dist/src/daemon.js"
  },
  "files": [
    "dist/src",
    "assets/admin",
    "assets/admin-dist",
    "assets/build-manifest.json",
    "assets/images/control",
    "assets/images/mcp",
    "assets/images/web",
    "assets/node",
    "assets/skill",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --enable-source-maps dist/src/daemon.js",
    "prepack": "npm run build && npm --prefix ../web run build && node ../../scripts/prepare-manager-package.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pack:check": "npm run prepack && npm pack --ignore-scripts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
