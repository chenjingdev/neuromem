{
  "name": "@neuromem/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Neuromem Control Gateway MCP adapter with a development node router",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "neuromem-mcp": "./dist/src/stdio.js",
    "neuromem-mcp-http": "./dist/src/http.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/src/http.js",
    "test": "npm run clean && npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0"
}
