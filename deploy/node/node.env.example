COMPOSE_PROJECT_NAME=neuromem-node
NEUROMEM_NODE_ID=replace-with-node-uuid

# Public edge. Cloudflare Tunnel is the only supported public ingress.
NEUROMEM_PUBLIC_HOST=memory.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
EDGE_LOOPBACK_PORT=24443
NODE_MANAGER_URL=http://host.docker.internal:14174
NODE_MANAGER_TIMEOUT_SECONDS=600

# Control plane database and signing secrets.
CONTROL_POSTGRES_DB=neuromem_control
CONTROL_POSTGRES_USER=neuromem_control
CONTROL_POSTGRES_PASSWORD=replace-with-random-secret
CONTROL_TOKEN_PEPPER=replace-with-32-byte-random-secret
CONTROL_INTERNAL_SIGNING_KEY=replace-with-32-byte-random-secret
CONTROL_SECURE_COOKIES=true

# Local loopback testing only. Never enable with a public host or Cloudflare Tunnel.
LOCAL_TEST_LOGIN_PREFILL=false
LOCAL_TEST_LOGIN_EMAIL=
LOCAL_TEST_LOGIN_PASSWORD=

# AGPL memory-core database/cache.
MEMORY_POSTGRES_DB=neuromem_memory
MEMORY_POSTGRES_USER=neuromem_memory
MEMORY_POSTGRES_PASSWORD=replace-with-random-secret
MEMORY_REDIS_PASSWORD=replace-with-random-secret
MEMORY_INTERNAL_SIGNING_KEY=replace-with-the-control-signing-key
MEMORY_AUTH_JWT_SECRET=replace-with-random-jwt-signing-secret

# Model endpoints remain on the private Docker network or host loopback.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=local-model
EMBEDDING_MODEL=qwen3-embedding-honcho-8192
EMBEDDING_VECTOR_DIMENSIONS=1536
GENERATION_BASE_URL=http://host.docker.internal:11435/v1
GENERATION_API_KEY=local-model
GENERATION_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
GENERATION_SOURCE=openai_compatible
GENERATION_DIRECT_BASE_URL=http://host.docker.internal:11435/v1
GENERATION_DIRECT_API_KEY=local-model
GENERATION_DIRECT_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
NODE_CODEX_BRIDGE_TOKEN=replace-with-random-secret
DERIVER_BATCH_TARGET_TOKENS=512
DERIVER_BATCH_MAX_AGE_SECONDS=1800

# Immutable deployment inputs. Pin released images by digest in production.
MEMORY_CORE_IMAGE=ghcr.io/chenjingdev/neuromem-memory-core@sha256:15669c488866012c2762a4eefca2e8e9aa3b589a3eb874f12e49c8917aa7e365
MEMORY_CORE_SOURCE_URL=https://github.com/chenjingdev/neuromem-memory-core
MEMORY_CORE_SOURCE_REVISION=307a6051ffe0b56bfaad88d8c905f4aa00f73724
CONTROL_IMAGE=neuromem-control:local
MCP_IMAGE=neuromem-mcp:local
WEB_IMAGE=neuromem-web:local

# The model server is external by default on Mac and DGX. A future pinned
# Compose model profile may set this true after its image has been qualified.
DGX_MODEL_ENABLED=false

# Named volumes make rollback explicit.
CONTROL_DB_VOLUME=neuromem-node-control-db
MEMORY_DB_VOLUME=neuromem-node-memory-db
MEMORY_REDIS_VOLUME=neuromem-node-memory-redis
MCP_STATE_VOLUME=neuromem-node-mcp
